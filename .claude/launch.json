{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "electrolab",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "electrolab-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "env": {
        "ELECTROLAB_API_PROXY": "http://127.0.0.1:8099"
      }
    }
  ]
}
