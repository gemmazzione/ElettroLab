# ElectroLab - configurazione Apache (hosting Linux, es. Aruba)
# L'applicazione è statica: nessun PHP o database richiesto.

Options -Indexes
DirectoryIndex index.html

# Tipi MIME dei moduli JavaScript
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

# Compressione
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Cache: i file in assets/ hanno l'hash nel nome e possono restare in cache a lungo;
# index.html va sempre ricontrollato per ricevere subito gli aggiornamenti.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
